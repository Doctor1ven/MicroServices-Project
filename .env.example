NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/database
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-this-with-another-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_MS=604800000
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MS=900000
RESET_TOKEN_TTL_MS=900000
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
BACKEND_PUBLIC_URL=http://localhost:5001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGIN=*
